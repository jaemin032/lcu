{
  "manifest_version": 3,
  "name": "LCU Local Browser",
  "version": "1.0.0",
  "description": "Connect LCU to approved tabs in this browser.",
  "key": "",
  "permissions": ["debugger", "nativeMessaging", "scripting"],
